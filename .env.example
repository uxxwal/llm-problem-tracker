# TEMPLATE ONLY — this file IS committed to git. Never put a real key here.
# Copy it to .env (which is gitignored) and put your real key in that copy:
#     cp .env.example .env
#     open -e .env
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL=gpt-4o-mini

# Extraction sampling. Extraction has one intended answer, so it runs
# deterministic by default. Raise this only to MEASURE sampling variance.
LLM_TEMPERATURE=0

# Conversational replies. Left at the API default; applies to both arms alike.
LLM_REPLY_TEMPERATURE=1.0

# Optional, best-effort reproducibility. Set while comparing prompt versions so
# a difference is attributable to the prompt; leave UNSET for study runs.
# LLM_SEED=1234

